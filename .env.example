# Catalog Greenlight — copy to .env and fill in secrets
#
# === Gemini auth (pick ONE path) ===
#
# Path A — Vertex AI (recommended for hosted demo / hackathon GCP credits):
# Bills the GCP project. Partner Marketing / promotional credits apply here.
# AI Studio prepaid does NOT refill from GCP credits.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# # Local: gcloud auth application-default login
# # OR path to service-account JSON:
# # GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/sa.json
# # OR inline JSON (Render secret — do not commit):
# # GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
#
# Path B — AI Studio apiKey (local/dev fallback when Vertex env is unset):
# Key from https://aistudio.google.com/apikey (AIza… or AQ.…).
# Billing must be active (prepaid credit > $0) or /ask and ingest fail with 429.
GEMINI_API_KEY=
# Optional comma-separated backups if the primary key hits prepaid quota (rotated automatically).
# GEMINI_API_KEYS=
GEMINI_MODEL=gemini-flash-latest

# ClickHouse (local Docker defaults)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=media_catalog
CLICKHOUSE_SECURE=false
CLICKHOUSE_ALLOW_WRITE_ACCESS=true

# MCP spawn (official mcp-clickhouse)
MCP_COMMAND=uv
MCP_ARGS=["run", "--with", "mcp-clickhouse", "--python", "3.13", "mcp-clickhouse"]

# API
PORT=8080
# Optional: when set, /api/v1/* (except /health) requires header X-API-Key. Leave unset for public hackathon demo.
# API_KEY=
