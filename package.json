{
  "name": "catalog-greenlight",
  "version": "0.1.0",
  "description": "Catalog Greenlight — Agentic Cinema hackathon. Gemini + mcp-clickhouse programming agent for streaming catalogs.",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w @bas/core -w @bas/infrastructure -w @bas/orchestration -w @bas/web -w @bas/api -w @bas/media-workflows-examples --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules dist",
    "dev": "concurrently --kill-others-on-fail false -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace=@bas/web",
    "dev:orchestration": "npm run dev --workspace=packages/orchestration",
    "dev:api": "PATH=\"$HOME/.local/bin:$PATH\" npm run dev --workspace=packages/api",
    "start:demo": "npm run start:demo --workspace=@bas/media-workflows-examples",
    "start:ingestion": "npm run start:ingestion --workspace=@bas/media-workflows-examples",
    "demo": "bash deployment/scripts/demo.sh",
    "check:credentials": "ts-node deployment/scripts/check-credentials.ts",
    "test:e2e": "npm run test:e2e --workspace=@bas/web",
    "test:e2e:hosted": "npm run test:e2e:hosted --workspace=@bas/web",
    "deploy:infra": "bash scripts/deploy.sh",
    "keepalive:smoke": "bash scripts/keepalive-smoke.sh",
    "judge:smoke": "bash scripts/judge-smoke.sh",
    "setup": "bash scripts/setup.sh"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "turbo": "^1.10.0",
    "concurrently": "^8.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "clickhouse",
    "mcp",
    "gemini",
    "hackathon",
    "agentic-ai",
    "google-cloud",
    "media-entertainment",
    "enterprise"
  ],
  "author": "Blockbuster Agentic Studio Team",
  "license": "MIT"
}
